{
  "project_type": "monorepo",
  "project_type_details": "Native SwiftUI iOS/macOS app, React 18 + Vite webapp, PlatformIO C++ ESP32 T-Deck firmware and host simulator",
  "is_react_native": false,
  "is_ios": true,
  "is_android": false,
  "is_expo": false,
  "is_web": true,
  "is_flutter": false,
  "is_native_ios": true,
  "is_native_android": false,
  "startup_commands": [
    {
      "command": "pnpm --dir webapp dev",
      "context": "React/Vite webapp"
    }
  ],
  "build_commands": [
    {
      "command": "./scripts/build_ios.sh",
      "platform": "ios",
      "context": "PommeCore.xcodeproj; scheme PommeCore; ios/DerivedData; unsigned simulator"
    },
    {
      "command": "xcodebuild -project ios/PommeCore.xcodeproj -scheme PommeCore-macOS -destination 'platform=macOS' CODE_SIGNING_ALLOWED=NO build",
      "platform": "macos",
      "context": "Also invoked by ./scripts/test_all.sh --host-only"
    },
    {
      "command": "pnpm --dir webapp build",
      "platform": "web",
      "context": "Vite"
    },
    {
      "command": "pio run -e t-deck",
      "platform": "firmware",
      "context": "PlatformIO espressif32 6.13.0 Arduino"
    },
    {
      "command": "pio run -e simulator",
      "platform": "host",
      "context": "PlatformIO native 1.2.1"
    }
  ],
  "argent_workflow": {
    "start_dev_server": null,
    "build_ios": "./scripts/build_ios.sh",
    "build_android": null,
    "notes": "Native app, no Metro. Root coordinates simulator use. Installed environment-inspector guidance found in ~/.claude/agents. Root located Argent skills at /Users/maxmohammadi/.nvm/versions/node/v22.22.1/lib/node_modules/@swmansion/argent/skills."
  },
  "ios_has_podfile": false,
  "android_has_gradle": false,
