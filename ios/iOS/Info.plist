<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>Lilyshark</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<!-- Literal, not $(PRODUCT_NAME): the Xcode target and its built product keep
	     upstream's PommeCore name so the project's product references and the
	     embed-extension build phases still resolve. Only the shown name is ours. -->
	<key>CFBundleName</key>
	<string>Lilyshark</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Lilyshark shows your location on the mesh map and can include it in your advertisements.</string>
	<key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
	<string>Lilyshark uses your location for the mesh map and to automatically send an emergency beacon if you leave a safe zone.</string>
	<key>NSCameraUsageDescription</key>
	<string>Lilyshark uses the camera to scan QR codes for importing contacts and channels.</string>
	<key>NSFaceIDUsageDescription</key>
	<string>Lilyshark uses Face ID to protect your messages when App Lock is enabled.</string>
	<key>NSBluetoothAlwaysUsageDescription</key>
	<string>Lilyshark needs Bluetooth to communicate with your LoRa radio device for off-grid mesh messaging.</string>
	<key>NSBluetoothPeripheralUsageDescription</key>
	<string>Lilyshark needs Bluetooth to communicate with your LoRa radio device for off-grid mesh messaging.</string>
	<key>UIBackgroundModes</key>
	<array>
		<string>bluetooth-central</string>
		<string>remote-notification</string>
	</array>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.lilyshark.app</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>meshcore</string>
			</array>
		</dict>
	</array>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSExceptionDomains</key>
		<dict>
			<key>192.168.4.1</key>
			<dict>
				<key>NSExceptionAllowsInsecureHTTPLoads</key>
				<true/>
				<key>NSIncludesSubdomains</key>
				<false/>
			</dict>
		</dict>
	</dict>
	<key>NSHumanReadableCopyright</key>
	<string>Copyright © 2026 Michael Bedworth. All rights reserved.</string>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>UILaunchScreen</key>
	<dict/>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
</dict>
</plist>
